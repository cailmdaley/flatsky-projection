# Projection stage: one job = one (leg, projection, seed).
# Submitted only via grid/submit.sh project [glob ...]
include : grid/common.sub

executable              = grid/stages/project.sh
arguments               = "$(stagescript) $(proj) $(seed)"

request_cpus            = 4
request_disk            = 4GB

transfer_input_files    = grid/env.sh, \
                          osg_test/scratch/spt3g_build.tar.gz, \
                          src/stages/$(stagescript), \
                          src/stages/_project.py, \
                          src/stages/_decisions.py, \
                          /sptlocal/user/cailmdaley/pol_project/preprocessed_alms_l6000/alms_seed$(seedpad).fits

queue unit,outpath,outfile,mem,stagescript,leg,proj,seed,seedpad from $(joblist)
