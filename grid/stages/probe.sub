# Probe stage: cheap end-to-end validation of the apparatus itself
# (common.sub macros, +PolUnit dedup, env.sh toolset pin, push_output in both
# condor-remap and gfal modes). Costs a minute and a gigabyte.
#   grid/submit.sh probe            2 units, condor remap to /sptlocal
#   grid/submit.sh probe --gfal     the same 2 units, pushed to /sptgrid
include : grid/common.sub

executable              = grid/stages/probe.sh
arguments               = "$(outfile)"

request_cpus            = 1
request_disk            = 1GB

transfer_input_files    = grid/env.sh

queue unit,outpath,outfile,mem from $(joblist)
