# Step 3: real data movement against the SPT dCache, using only the token the
# Access Point issues automatically. No grid proxy, no user credential.
#
# The davs:// entry in transfer_input_files is the point of the test. URL-based
# transfers are also exempt from MAX_TRANSFER_INPUT_MB (5000, unoverridable),
# which is what makes 9 GB simulation inputs possible at all.

universe                = vanilla
executable              = probe4.sh
output                  = probe4.$(ClusterId).$(ProcId).out
error                   = probe4.$(ClusterId).$(ProcId).err
log                     = probe4.$(ClusterId).log

request_cpus            = 1
request_memory          = 2GB
request_disk            = 4GB

+ProjectName            = "spt"
+SingularityImage       = "/cvmfs/singularity.opensciencegrid.org/htc/rocky:9"

Requirements            = HAS_CVMFS_spt_opensciencegrid_org == True

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

# Ask for the AP-issued SciToken. Harmless if the AddSciToken transform already
# set OAuthServicesNeeded schedd-side; required if it did not.
use_oauth_services      = scitokens

transfer_input_files    = davs://osg-gridftp.grid.uchicago.edu:2880/sptgrid/user/cailmdaley/tarballs/spt3g.tgz

# Do not drag the 36 MB tarball back again.
transfer_output_files   = ""

queue 3
