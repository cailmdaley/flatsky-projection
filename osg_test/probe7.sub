# Step 4: real-data round trip via plain HTCondor file transfer — no credential.
# 458 MB alms in from /sptlocal (submit node reads it; worker needs no mount),
# spectra out. This is the staging pattern the production pipeline will use.

universe                = vanilla
executable              = probe7.sh
output                  = probe7.$(ClusterId).$(ProcId).out
error                   = probe7.$(ClusterId).$(ProcId).err
log                     = probe7.$(ClusterId).log

request_cpus            = 1
request_memory          = 4GB
request_disk            = 4GB

+ProjectName            = "spt"
+SingularityImage       = "/cvmfs/singularity.opensciencegrid.org/htc/rocky:9"

Requirements            = HAS_CVMFS_spt_opensciencegrid_org == True

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = /sptlocal/analysis/pol_project2020/results/preprocessed_alms/almsTQU_seed0.fits
transfer_output_files   = probe7_cls_seed0.txt

queue 1
