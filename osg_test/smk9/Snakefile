# Minimal end-to-end validation of the htcondor9 Snakemake profile.
# One rule, runs on an OSG worker via the pinned CVMFS py3-v5 toolset,
# imports pymaster to prove the scientific stack is live, and writes an
# output that comes back to the submit host via plain HTCondor file transfer
# (no shared filesystem).

rule all:
    input:
        "out/probe.txt"

rule probe:
    output:
        "out/probe.txt"
    resources:
        htcondor_request_mem_mb=2000,
        htcondor_request_disk_mb=2000,
    shell:
        r"""
        mkdir -p out
        python3 -c "
import socket, os, datetime
import pymaster as nmt
with open('out/probe.txt', 'w') as f:
    f.write('host=' + socket.gethostname() + chr(10))
    f.write('site=' + os.environ.get('GLIDEIN_ResourceName', 'unset') + chr(10))
    f.write('pymaster=' + nmt.__version__ + chr(10))
    f.write('date=' + datetime.datetime.utcnow().isoformat() + 'Z' + chr(10))
"
        """
