# Step 2b: pinned container + pinned OS_ARCH. Eight jobs to sample widely --
# probe2 showed the answer varies by site, so a single job proves nothing.

universe                = vanilla
executable              = probe3.sh
output                  = probe3.$(ClusterId).$(ProcId).out
error                   = probe3.$(ClusterId).$(ProcId).err
log                     = probe3.$(ClusterId).log

request_cpus            = 1
request_memory          = 2GB
request_disk            = 2GB

+ProjectName            = "spt"
+AccountingGroup        = "group_opportunistic.spt.cailmdaley"

# Pin the userspace. Without this OSPool uses each site's default image, which
# probe2 saw vary from rocky:8 to debian:13 -- and the SPT CVMFS stack is built
# for RHEL only.
+SingularityImage       = "/cvmfs/singularity.opensciencegrid.org/htc/rocky:9"

Requirements            = HAS_CVMFS_spt_opensciencegrid_org == True && HAS_SINGULARITY == True

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

queue 8
