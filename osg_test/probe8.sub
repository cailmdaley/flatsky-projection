# Step 5: spt3g_software build shipped to the worker as a 57 MB tarball.
universe                = vanilla
executable              = probe8.sh
output                  = probe8.$(ClusterId).$(ProcId).out
error                   = probe8.$(ClusterId).$(ProcId).err
log                     = probe8.$(ClusterId).log

request_cpus            = 1
request_memory          = 4GB
request_disk            = 4GB

+ProjectName            = "spt"
+SingularityImage       = "/cvmfs/singularity.opensciencegrid.org/htc/rocky:9"

Requirements            = HAS_CVMFS_spt_opensciencegrid_org == True && HAS_SINGULARITY == True

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = scratch/spt3g_build.tar.gz

queue 1
